{
  "name": "workout-pro-tailwind-build",
  "version": "1.0.0",
  "private": true,
  "description": "Local Tailwind CSS build for Workout Pro (replaces the CDN script)",
  "scripts": {
    "build:css": "tailwindcss -i ./input.css -o ../css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./input.css -o ../css/tailwind.css --minify --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
